{% raw %}[project]
name = "{% endraw %}{{ package_name | replace('_', '-') }}{% raw %}"
version = "0.1.0"
description = "{% endraw %}{{ description }}{% raw %}"
authors = [
    {name = "{% endraw %}{{ primary_author }}{% raw %}"},

]
readme = "README.md"
requires-python = ">={% endraw %}{{ python_version }}{% raw %}"
classifiers = [
    "Programming Language :: Python :: 3",
{% endraw %}{% for item in python_ci_versions %}
    {% raw %}"Programming Language :: Python :: {% endraw %}{{ item.split('.')[:2] | join('.') }}{% raw %}",{% endraw %}
{% endfor %}{% raw %}
]
dependencies = [

]


[dependency-groups]
dev = [
    # Specific to this repository


    # Managed by upstream template
    "pyright{% endraw %}{{ pyright_version }}{% raw %}",
    "pyrefly{% endraw %}{{ pyrefly_version }}{% raw %}",
    "pytest{% endraw %}{{ pytest_version }}{% raw %}",
    "pytest-cov{% endraw %}{{ pytest_cov_version }}{% raw %}",
    "pytest-randomly{% endraw %}{{ pytest_randomly_version }}{% raw %}",{% endraw %}{% if configure_vcrpy %}{% raw %}
    "pytest-recording{% endraw %}{{ pytest_recording_version }}{% raw %}",
    "vcrpy{% endraw %}{{ vcrpy_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}
    "mutmut{% endraw %}{{ mutmut_version }}{% raw %}",{% endraw %}{% if create_docs %}{% raw %}
    "sphinx=={% endraw %}{{ sphinx_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}{% endraw %}{% if deploy_as_executable %}{% raw %}
    "pyinstaller{% endraw %}{{ pyinstaller_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}
]

[tool.setuptools]
license-files = [] # kludge until this bug is fixed https://github.com/pypa/setuptools/issues/4759

[tool.tach]
source_roots = ["src", "."]
exclude = [".venv", "**/__pycache__", "**/*.egg-info", "mutants"]

# Never import from a conftest.py (https://docs.pytest.org/en/stable/how-to/writing_plugins.html#conftest-py-local-per-directory-plugins);
# put shared helpers in a regular module instead. Declaring `tests` as a module is what makes tach check the tests'
# imports at all; a file outside every module is never checked.
[[tool.tach.modules]]
path = "tests"
cannot_depend_on = ["tests.**.conftest"]

# Makes each conftest.py its own module, so the rule above has something to match. tach puts a file only in its most
# specific module, so conftests are not part of `tests` and need the rule repeated to block conftest-to-conftest imports.
# `visibility = []` also rejects any module that lists a conftest in its `depends_on`. It can't stop a module that omits
# `depends_on`, so any other module declared under `tests` needs the same `cannot_depend_on` line.
[[tool.tach.modules]]
path = "tests.**.conftest"
cannot_depend_on = ["tests.**.conftest"]
visibility = []

[tool.uv]
package = true

{% endraw %}{% if python_package_registry == "PyPI" %}{% raw %}[[tool.uv.index]]
name = "pypi"
url = "https://pypi.org/simple/"
publish-url = "https://upload.pypi.org/legacy/"

[[tool.uv.index]]
name = "testpypi"
url = "https://test.pypi.org/simple/"
publish-url = "https://test.pypi.org/legacy/"{% endraw %}{% else %}{% raw %}

[[tool.uv.index]]
default = true
name = "code-artifact-primary"
username = "aws"
publish-username = "aws"
url = "https://{% endraw %}{{ repo_org_name }}{% raw %}-{% endraw %}{{ aws_central_infrastructure_account_id }}{% raw %}.d.codeartifact.{% endraw %}{{ aws_org_home_region }}{% raw %}.amazonaws.com/pypi/{% endraw %}{{ repo_org_name }}{% raw %}-primary/simple/"
publish-url = "https://{% endraw %}{{ repo_org_name }}{% raw %}-{% endraw %}{{ aws_central_infrastructure_account_id }}{% raw %}.d.codeartifact.{% endraw %}{{ aws_org_home_region }}{% raw %}.amazonaws.com/pypi/{% endraw %}{{ repo_org_name }}{% raw %}-primary/"

[[tool.uv.index]]
name = "code-artifact-staging"
username = "aws"
publish-username = "aws"
url = "https://{% endraw %}{{ repo_org_name }}{% raw %}-{% endraw %}{{ aws_central_infrastructure_account_id }}{% raw %}.d.codeartifact.{% endraw %}{{ aws_org_home_region }}{% raw %}.amazonaws.com/pypi/{% endraw %}{{ repo_org_name }}{% raw %}-staging/simple/"
publish-url = "https://{% endraw %}{{ repo_org_name }}{% raw %}-{% endraw %}{{ aws_central_infrastructure_account_id }}{% raw %}.d.codeartifact.{% endraw %}{{ aws_org_home_region }}{% raw %}.amazonaws.com/pypi/{% endraw %}{{ repo_org_name }}{% raw %}-staging/"{% endraw %}{% endif %}
